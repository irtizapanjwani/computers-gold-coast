---
// Layout for the original (not yet redesigned) pages. They keep the original header, footer and
// scripts (src/data/legacy-*.html), styled by each page's own inline CSS. The redesigned Home,
// About and Reviews pages use PageLayout.astro with the new Header/Footer components instead.
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
import legacyHeader from '../data/legacy-header.html?raw';
import legacyFooter from '../data/legacy-footer.html?raw';
import legacyScripts from '../data/legacy-body-scripts.html?raw';

interface Props {
  headHtml: string;
  bodyHtml: string;
  footerHtml?: string | null;
  bare?: boolean;
}
const { headHtml, bodyHtml, footerHtml = null, bare = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<Fragment set:html={headHtml} />
<GtmHead />
</head>
<body>
<GtmBody />
{bare ? (
  <Fragment set:html={bodyHtml} />
) : (
  <Fragment>
    <Fragment set:html={legacyHeader} />
    <Fragment set:html={bodyHtml} />
    <Fragment set:html={footerHtml ?? legacyFooter} />
    <Fragment set:html={legacyScripts} />
  </Fragment>
)}
</body>
</html>
