---
// Layout for the redesigned Home, About and Reviews pages. Same shared header,
// footer, GTM and scripts as Layout.astro, with real Astro markup instead of HTML strings.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GtmHead from '../components/GtmHead.astro';
import GtmBody from '../components/GtmBody.astro';
import Icons from '../components/redesign/Icons.astro';
import bodyScripts from '../data/body-scripts.html?raw';
import { SITE } from '../data/site';
import '../styles/redesign.css';

interface Props {
  title: string;
  description: string;
  path: string;
  shareDescription?: string;
  schema: object[];
}
const { title, description, path, shareDescription = description, schema } = Astro.props;
const url = path === '/' ? `${SITE}/` : `${SITE}${path}`;
// Loaded without blocking first paint (display=swap shows fallback text until it arrives).
const FONTS = 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@700&display=swap';
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Computers Gold Coast">
<meta property="og:locale" content="en_AU">
<meta property="og:title" content={title}>
<meta property="og:description" content={shareDescription}>
<meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={shareDescription}>
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href={FONTS}>
<link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={FONTS}></noscript>
<GtmHead />
</head>
<body>
<GtmBody />
<Icons />
<Header />
<main>
  <slot />
</main>
<Footer />
<Fragment set:html={bodyScripts} />
</body>
</html>
