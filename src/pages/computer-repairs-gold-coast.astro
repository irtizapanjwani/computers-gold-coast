---
// Computer Repairs service page, fully redesigned. The content is the page's original copy
// (Channel 9, IBM, services, onsite/remote/drop-off, reviews, areas), rewritten in sentence case
// and laid out with the shared service-page sections so other service pages can follow.
import PageLayout from '../layouts/PageLayout.astro';
import ServiceHero from '../components/redesign/ServiceHero.astro';
import ServiceIntro from '../components/service/ServiceIntro.astro';
import BootCheck from '../components/service/BootCheck.astro';
import RepairFlow from '../components/service/RepairFlow.astro';
import ServiceReviews from '../components/service/ServiceReviews.astro';
import Areas from '../components/redesign/Areas.astro';
import Faq from '../components/redesign/Faq.astro';
import CtaBand from '../components/redesign/CtaBand.astro';
import { SITE, businessSchema, faqSchema } from '../data/site';

const path = '/computer-repairs-gold-coast';
const url = `${SITE}${path}`;
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Computer Repairs' },
];

// Interactive "where does it stop?" section. Each step links to the page that covers that fix.
const bootStages = [
  { id: 'dead', step: 'Press power', symptom: 'Nothing happens when I press the power button', means: 'No lights and no fans usually points to power: a failed power supply, a loose cable or power board, or a faulty power button. Less often it’s the motherboard.', check: 'We test the power supply and connections first, because they’re the cheapest causes to rule out, then the board if needed.', href: '/hardware-repair-diagnostics-gold-coast', linkText: 'Hardware diagnostics' },
  { id: 'nosignal', step: 'Lights, no picture', symptom: 'The fans spin but the screen stays black', means: 'The computer has power but isn’t getting to a picture. Common causes are a loose memory stick, a failed graphics card, or simply the monitor cable or input setting.', check: 'We check the monitor and cable, reseat and test the memory and graphics, and narrow it down before quoting any parts.', href: '/hardware-repair-diagnostics-gold-coast', linkText: 'Hardware diagnostics' },
  { id: 'bios', step: 'Error before Windows', symptom: 'It says no boot device or shows an error', means: 'The computer can’t find or read the drive Windows lives on. That can be a loose connection, a startup setting, or a drive that’s failing.', check: 'Your files come first: we check the drive’s health and copy your data off before trying any fix that could affect it.', href: '/data-recovery-gold-coast', linkText: 'Data recovery' },
  { id: 'loop', step: 'Stuck loading', symptom: 'It’s stuck restarting or won’t finish loading', means: 'Usually a Windows update that failed part-way, a bad driver, or system files that have been damaged. Occasionally it’s an early sign of a failing drive.', check: 'We repair Windows where we can and only reinstall when we have to, after your files are backed up.', href: '/operating-system-install-repair-gold-coast', linkText: 'Windows install & repair' },
  { id: 'slow', step: 'Slow or pop‑ups', symptom: 'It loads, but it’s painfully slow and full of pop-ups', means: 'Too many programs loading at startup, a nearly full or ageing hard drive, or adware and malware running in the background.', check: 'We clean up startup items and remove any infection. If the hardware is holding it back, a new SSD or more memory is often the real fix.', href: '/computer-tune-up-gold-coast', linkText: 'Computer tune-ups' },
  { id: 'net', step: 'Internet & devices', symptom: 'It works, but the internet or printer doesn’t', means: 'The computer itself is fine. The problem is between it and the network, the Wi-Fi, or a printer or device that’s lost its connection or driver.', check: 'We sort out the network settings, Wi-Fi coverage and device drivers so everything connects reliably.', href: '/wireless-networks-setup-gold-coast', linkText: 'Wi-Fi & network setup' },
];

const jobLinks = [
  { label: 'Virus & spyware removal', href: '/virus-spyware-removal-gold-coast' },
  { label: 'Hardware upgrades', href: '/hardware-installs-upgrades-gold-coast' },
  { label: 'Network security', href: '/computer-network-security-gold-coast' },
  { label: 'New computer setup', href: '/new-computer-setup-gold-coast' },
  { label: 'Custom computer builds', href: '/custom-computer-builds-gold-coast' },
  { label: 'Preventative maintenance', href: '/preventative-maintenance-gold-coast' },
  { label: 'Laptop repairs', href: '/laptop-repairs-gold-coast' },
  { label: 'Mac repairs', href: '/mac-repairs-gold-coast' },
];

// "How it works": the same four steps, shown for onsite, remote or drop-off.
const flowModes = [
  { id: 'onsite', label: 'Onsite', icon: 'home', bestFor: 'Computers that won’t start, network and printer problems, new setups' },
  { id: 'remote', label: 'Remote', icon: 'monitor', bestFor: 'Viruses and pop-ups, slow computers, email and software issues' },
  { id: 'dropoff', label: 'Drop-off', icon: 'box', bestFor: 'Hardware part replacements, data recovery, bigger upgrades' },
] as const;

const flowSteps = [
  {
    title: 'Tell us what’s wrong',
    you: 'Call, or send the quote form with your computer and what it’s doing. A photo of any error message helps.',
    us: { onsite: 'Work out what the visit needs and book a time at your home or office.', remote: 'Check it’s a software problem we can fix remotely, then book a session.', dropoff: 'Check it’s a job for the bench and arrange a time for you to drop it off.' },
    get: { onsite: 'A booked visit, with no call-out fee', remote: 'A remote session, no travel needed', dropoff: 'A drop-off time that suits you' },
  },
  {
    title: 'We find the fault',
    you: { onsite: 'Show the technician the problem. Stay and watch if you like.', remote: 'Let us connect to your computer. You can watch everything on screen.', dropoff: 'Drop the computer off and get on with your day.' },
    us: { onsite: 'Test it at your place, starting with the cheapest likely causes.', remote: 'Diagnose it over the internet while you’re connected.', dropoff: 'Test it properly on the bench, starting with the cheapest likely causes.' },
    get: 'The cause, explained in plain English',
  },
  {
    title: 'You approve the price',
    you: 'Decide whether to go ahead. Nothing starts until you’ve said yes.',
    us: { onsite: 'Give you the price before any work, and say so if a repair isn’t worth it.', remote: 'Give you the price before any work, and say so if a repair isn’t worth it.', dropoff: 'Call you with the cause and the price, and say so if a repair isn’t worth it.' },
    get: 'The price before the work, no surprises',
  },
  {
    title: 'Fixed and explained',
    you: { onsite: 'Check it’s working before the technician leaves.', remote: 'Check it’s working before we disconnect.', dropoff: 'Collect it when we call to say it’s ready.' },
    us: { onsite: 'Fix it on the spot where we can, or order the part if one is needed.', remote: 'Fix it remotely and show you what was wrong.', dropoff: 'Fix it, test it and let you know it’s ready to collect.' },
    get: 'A working computer, plus free advice afterwards',
  },
];

const faqs = [
  { q: 'How much does a computer repair cost on the Gold Coast?', a: 'It depends on the fault and the machine, so we diagnose first and give you the price before any work starts. There’s no call-out fee, and nothing goes ahead until you’ve said yes.' },
  { q: 'Is it worth repairing an old computer?', a: 'Often, yes. A new SSD or more memory can make an older PC feel new for far less than a replacement. If a repair isn’t worth the money, we’ll tell you, and we can help you <a href="/laptop-buying-service-gold-coast">choose a replacement</a>.' },
  { q: 'Can you fix my computer without coming out?', a: 'Many software problems, like viruses, slowdowns and email issues, can be fixed remotely. Hardware faults need hands-on work, either onsite at your home or office or as a drop-off.' },
  { q: 'Do you fix all brands of desktop PCs?', a: 'Yes. We repair desktop PCs from every major brand, as well as <a href="/laptop-repairs-gold-coast">laptops</a> and <a href="/mac-repairs-gold-coast">Macs</a>.' },
  { q: 'Will I lose my files during the repair?', a: 'We take care to protect your data and tell you before doing anything that could affect your files. If a drive has already failed, our <a href="/data-recovery-gold-coast">data recovery</a> service can often get your files back.' },
  { q: 'Can you help with an insurance claim for a damaged computer?', a: 'Yes. If your computer was damaged by a storm, power surge or water, we can assess it and provide an <a href="/insurance-reports-gold-coast">insurance report</a>.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        '@id': `${url}#service`,
        name: 'Computer Repairs Gold Coast',
        serviceType: 'Computer repairs',
        url,
        description: 'Onsite, remote and drop-off computer and PC repairs across the Gold Coast, including diagnostics, speed-ups, upgrades, virus removal and data recovery.',
        provider: businessSchema,
        areaServed: businessSchema.areaServed,
      },
      {
        '@type': 'BreadcrumbList',
        '@id': `${url}#breadcrumb`,
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          item: c.href ? `${SITE}${c.href === '/' ? '/' : c.href}` : url,
        })),
      },
    ],
  },
  faqSchema(faqs, url),
];
---
<PageLayout
  title="Computer Repairs Gold Coast | Computers Gold Coast"
  description="Reliable, affordable computer and PC repairs across the Gold Coast. Onsite, remote or drop-off. Virus removal, tune-ups, hardware upgrades and honest advice, 7 days a week."
  shareDescription="Reliable, affordable computer and PC repairs across the Gold Coast. Onsite, remote or drop-off, 7 days a week."
  path={path}
  schema={schema}
>
  <ServiceHero
    eyebrow="Computer repairs · Gold Coast"
    title="Computer repairs on the Gold Coast."
    highlight="Fast, honest, onsite or remote."
    intro="PCs, laptops and Macs fixed at your home or office, remotely, or via drop-off. Led by a Microsoft Certified Professional with 20 years’ experience."
    breadcrumbs={breadcrumbs}
    path={path}
    formPlaceholder="e.g. PC is slow and keeps freezing"
  />

  <ServiceIntro
    eyebrow="Why Computers Gold Coast"
    title="A computer technician who finds the real fault first."
    paragraphs={[
      'Choosing a computer technician can feel daunting when there are so many companies to pick from. Computers Gold Coast has been fixing PCs, laptops and Macs for 20 years. We’ve been featured on Channel 9 news, and our director is a Microsoft Certified Professional who was previously the youngest employee at IBM in Australia.',
      'Most people are grateful for a technician who helps them out and goes over and above, and that’s what we aim for on every job. If you already know what’s wrong, send us the details and we’ll give you a straight quote before booking anything in.',
      'It’s not just repairs. We install new hardware, make sure your network is set up properly, and get a new computer fully configured before we leave. Need a <a href="/laptop-repairs-gold-coast">laptop repair</a> or a <a href="/mac-repairs-gold-coast">MacBook repair</a>? We do those too.',
    ]}
    listTitle="On every computer repair"
    list={[
      { title: 'Diagnosis before a quote', text: 'We find what’s actually wrong instead of guessing.' },
      { title: 'The price before the work', text: 'Nothing starts until you’ve said yes.' },
      { title: 'Plain-English explanations', text: 'You’ll know what was wrong and what we did.' },
      { title: 'Free advice afterwards', text: 'We don’t disappear once the invoice is paid.' },
    ]}
  />

  <BootCheck
    eyebrow="What we fix"
    title="Where does your computer stop?"
    intro="Every computer goes through the same steps when you switch it on. Pick the step where yours gets stuck, and we’ll tell you what it usually means and how we fix it."
    stages={bootStages}
    links={jobLinks}
  />

  <RepairFlow
    eyebrow="How it works"
    title="From the first call to a fixed computer."
    intro="Onsite, remote or drop-off, every repair follows the same four steps. Choose how you’d like it done and see exactly how yours would go."
    modes={flowModes}
    steps={flowSteps}
    note="Open 7 days a week, 7AM to 10PM, including weekends and public holidays."
  />

  <ServiceReviews
    title="What customers say about our computer repairs."
    intro="In Gold Coast customers’ own words."
    picks={[0, 1, 3]}
  />

  <section class="sec" aria-labelledby="svc-areas-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="svc-eyebrow">Where we work</p>
        <h2 id="svc-areas-title">Computer repairs across the Gold Coast.</h2>
        <p class="lede">From Coomera to Coolangatta and up to Tamborine Mountain. Not sure if we cover your suburb? <a class="link" href="tel:+61447266455">Give us a call</a>.</p>
      </div>
      <Areas showBrands />
    </div>
  </section>

  <section class="sec sec-alt" aria-label="Frequently asked questions">
    <div class="wrap">
      <Faq title="Computer repair questions, answered." intro="Can’t see your question here? Give us a call. You’ll talk to a technician, not a call centre." items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Get your computer fixed today."
    text="Book an onsite visit, connect remotely or drop it off. You’ll get the cause and the price before any work starts."
    href="#quote"
    label="Get a free quote"
  />
</PageLayout>
