---
// Computer Repairs service page, fully redesigned. The content is the page's original copy
// (Channel 9, IBM, services, onsite/remote/drop-off, reviews, areas), rewritten in sentence case
// and laid out with the shared service-page sections so other service pages can follow.
import PageLayout from '../layouts/PageLayout.astro';
import ServiceHero from '../components/redesign/ServiceHero.astro';
import WhoFixes from '../components/service/WhoFixes.astro';
import BootCheck from '../components/service/BootCheck.astro';
import HowItWorks from '../components/service/HowItWorks.astro';
import ServiceReviews from '../components/service/ServiceReviews.astro';
import Areas from '../components/redesign/Areas.astro';
import Faq from '../components/redesign/Faq.astro';
import CtaBand from '../components/redesign/CtaBand.astro';
import { SITE, businessSchema, faqSchema } from '../data/site';

const path = '/computer-repairs-gold-coast';
const url = `${SITE}${path}`;
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Computer Repairs' },
];

// Interactive "where does it stop?" section. Each step links to the page that covers that fix.
const bootStages = [
  { id: 'dead', step: 'Press power', symptom: 'Nothing happens when I press the power button', means: 'No lights and no fans usually points to power: a failed power supply, a loose cable or power board, or a faulty power button. Less often it’s the motherboard.', check: 'We test the power supply and connections first, because they’re the cheapest causes to rule out, then the board if needed.', href: '/hardware-repair-diagnostics-gold-coast', linkText: 'Hardware diagnostics' },
  { id: 'nosignal', step: 'Lights, no picture', symptom: 'The fans spin but the screen stays black', means: 'The computer has power but isn’t getting to a picture. Common causes are a loose memory stick, a failed graphics card, or simply the monitor cable or input setting.', check: 'We check the monitor and cable, reseat and test the memory and graphics, and narrow it down before quoting any parts.', href: '/hardware-repair-diagnostics-gold-coast', linkText: 'Hardware diagnostics' },
  { id: 'bios', step: 'Error before Windows', symptom: 'It says no boot device or shows an error', means: 'The computer can’t find or read the drive Windows lives on. That can be a loose connection, a startup setting, or a drive that’s failing.', check: 'Your files come first: we check the drive’s health and copy your data off before trying any fix that could affect it.', href: '/data-recovery-gold-coast', linkText: 'Data recovery' },
  { id: 'loop', step: 'Stuck loading', symptom: 'It’s stuck restarting or won’t finish loading', means: 'Usually a Windows update that failed part-way, a bad driver, or system files that have been damaged. Occasionally it’s an early sign of a failing drive.', check: 'We repair Windows where we can and only reinstall when we have to, after your files are backed up.', href: '/operating-system-install-repair-gold-coast', linkText: 'Windows install & repair' },
  { id: 'slow', step: 'Slow or pop‑ups', symptom: 'It loads, but it’s painfully slow and full of pop-ups', means: 'Too many programs loading at startup, a nearly full or ageing hard drive, or adware and malware running in the background.', check: 'We clean up startup items and remove any infection. If the hardware is holding it back, a new SSD or more memory is often the real fix.', href: '/computer-tune-up-gold-coast', linkText: 'Computer tune-ups' },
  { id: 'net', step: 'Internet & devices', symptom: 'It works, but the internet or printer doesn’t', means: 'The computer itself is fine. The problem is between it and the network, the Wi-Fi, or a printer or device that’s lost its connection or driver.', check: 'We sort out the network settings, Wi-Fi coverage and device drivers so everything connects reliably.', href: '/wireless-networks-setup-gold-coast', linkText: 'Wi-Fi & network setup' },
];

const jobLinks = [
  { label: 'Virus & spyware removal', href: '/virus-spyware-removal-gold-coast' },
  { label: 'Hardware upgrades', href: '/hardware-installs-upgrades-gold-coast' },
  { label: 'Network security', href: '/computer-network-security-gold-coast' },
  { label: 'New computer setup', href: '/new-computer-setup-gold-coast' },
  { label: 'Custom computer builds', href: '/custom-computer-builds-gold-coast' },
  { label: 'Preventative maintenance', href: '/preventative-maintenance-gold-coast' },
  { label: 'Laptop repairs', href: '/laptop-repairs-gold-coast' },
  { label: 'Mac repairs', href: '/mac-repairs-gold-coast' },
];

// "How it works": three steps.
const howSteps: [{ title: string; text: string }, { title: string; text: string }, { title: string; text: string }] = [
  { title: 'Describe the fault', text: 'Call, or send the quote form with your computer and what it’s doing. A photo of any error message helps.' },
  { title: 'We diagnose and quote', text: 'Onsite at your home or office with no call-out fee, remotely, or on our bench. We find the real cause, then give you the price.' },
  { title: 'Approve the repair', text: 'Nothing starts until you’ve said yes. We fix it, explain what we did, and you get free advice afterwards.' },
];

// FAQs: practical answers to what people actually ask (and what they should know before
// they call). General advice plus only the business claims already made on the site.
const faqs = [
  { q: 'My computer is clicking, beeping or smells like burning. What should I do?', a: 'Switch it off and leave it off. A clicking or grinding noise usually means the hard drive is failing, and every time it’s turned on the drive can damage itself further, making your files harder to recover. A burning smell points to a failed power supply or component. Don’t keep restarting it to “see if it comes back”. Give us a call and we’ll tell you the safest next step, including <a href="/data-recovery-gold-coast">data recovery</a> if your files matter.' },
  { q: 'Is my old computer worth fixing, or should I buy a new one?', a: 'A quick rule of thumb: if the repair costs more than about half the price of a comparable new computer, replacing it usually makes more sense. But a lot of “slow old computers” aren’t worn out at all. They’re running on an old mechanical hard drive, and swapping it for an SSD (solid-state drive) can make them feel new for a fraction of the cost. We’ll tell you honestly which side of the line yours is on, and if a repair isn’t worth the money we’ll say so and can help you <a href="/laptop-buying-service-gold-coast">choose a replacement</a>.' },
  { q: 'Someone called saying they’re from Microsoft and my computer has a virus. Is it real?', a: 'No. Microsoft, Telstra and your bank will never cold-call you about a virus on your computer, and pop-ups with a phone number to call are scams too. Hang up, and don’t install anything they ask you to. If you’ve already let them connect, unplug the computer from the internet, change your banking and email passwords from a different device, and call your bank. Then get the computer checked: our <a href="/virus-spyware-removal-gold-coast">virus and spyware removal</a> includes removing any remote-access software they left behind.' },
  { q: 'How much does a computer repair cost?', a: 'It depends on what’s actually wrong, which is why we diagnose first and give you the price before any work starts. A software problem and a failed motherboard are very different jobs. There’s no call-out fee anywhere on the Gold Coast, and nothing goes ahead until you’ve said yes.' },
  { q: 'Can you fix it remotely, or do you need to come out?', a: 'Software problems like viruses, pop-ups, slow startups, email issues and program installs can usually be fixed remotely: you’ll see everything we do on your screen. Anything physical, like a computer that won’t power on, no picture, a noisy drive or a part replacement, needs hands-on work at your home or office, or as a drop-off. If you’re not sure, describe the problem and we’ll tell you which it is.' },
  { q: 'What should I do before the technician arrives?', a: 'A few things make the visit quicker: write down your Windows or Mac password and your email password if you know them, have the power cable and any chargers handy, and note any error message exactly, or take a photo of it. If the computer still works, it’s worth backing up anything important first. And if the problem comes and goes, jot down when it happens.' },
  { q: 'My computer got wet or was hit by a power surge. What now?', a: 'Unplug it straight away and don’t turn it back on, even if it seems fine. With liquid, powering it on before it’s been cleaned and dried can short the components; with a surge, it can finish off a part that was only damaged. If it happened in a storm or a power outage, it may be covered by your home or contents insurance, and we can assess it and provide an <a href="/insurance-reports-gold-coast">insurance report</a> for your claim.' },
  { q: 'Will I lose my files?', a: 'Most repairs don’t touch your files at all. If a fix could affect them, like reinstalling Windows or replacing a drive, we’ll tell you first, so they can be backed up before anything starts. If the drive has already failed, stop using the computer and talk to us about <a href="/data-recovery-gold-coast">data recovery</a>, because the less it’s used, the better the chance of getting your files back.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        '@id': `${url}#service`,
        name: 'Computer Repairs Gold Coast',
        serviceType: 'Computer repairs',
        url,
        description: 'Onsite, remote and drop-off computer and PC repairs across the Gold Coast, including diagnostics, speed-ups, upgrades, virus removal and data recovery.',
        provider: businessSchema,
        areaServed: businessSchema.areaServed,
      },
      {
        '@type': 'BreadcrumbList',
        '@id': `${url}#breadcrumb`,
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          item: c.href ? `${SITE}${c.href === '/' ? '/' : c.href}` : url,
        })),
      },
    ],
  },
  faqSchema(faqs, url),
];
---
<PageLayout
  title="Computer Repairs Gold Coast | Computers Gold Coast"
  description="Reliable, affordable computer and PC repairs across the Gold Coast. Onsite, remote or drop-off. Virus removal, tune-ups, hardware upgrades and honest advice, 7 days a week."
  shareDescription="Reliable, affordable computer and PC repairs across the Gold Coast. Onsite, remote or drop-off, 7 days a week."
  path={path}
  schema={schema}
>
  <ServiceHero
    eyebrow="Computer repairs · Gold Coast"
    title="Computer repairs on the Gold Coast."
    highlight="Fast, honest, onsite or remote."
    intro="PCs, laptops and Macs fixed at your home or office, remotely, or via drop-off. Led by a Microsoft Certified Professional with 20 years’ experience."
    breadcrumbs={breadcrumbs}
    path={path}
    formPlaceholder="e.g. PC is slow and keeps freezing"
  />


  <BootCheck
    eyebrow="What we fix"
    title="Where does your computer stop?"
    intro="Every computer goes through the same steps when you switch it on. Pick the step where yours gets stuck, and we’ll tell you what it usually means and how we fix it."
    stages={bootStages}
    links={jobLinks}
  />

  <HowItWorks
    eyebrow="How it works"
    title="From computer trouble to a clear repair plan."
    intro="Tell us what the computer is doing, and we’ll find the real cause before recommending any parts or work."
    steps={howSteps}
  />

  <WhoFixes
    eyebrow="Who picks up the phone"
    title="Not a franchise. Not a call centre."
    intro="With a lot of repair services, your call passes through several people before anyone touches your computer. Here’s how it works with us."
    chain={['Call centre', 'Booking queue', 'Contractor', 'Someone new next time']}
    paragraphs={[
      'Computers Gold Coast is a family-owned Gold Coast business that has been fixing PCs, laptops and Macs for 20 years. Most people are grateful for a technician who helps them out and goes over and above, and that’s what we aim for on every job.',
      'It’s not just repairs, either. We install new hardware, make sure your network is set up properly, and get a new computer fully configured before we leave. Need a <a href="/laptop-repairs-gold-coast">laptop repair</a> or a <a href="/mac-repairs-gold-coast">MacBook repair</a>? We do those too.',
    ]}
    facts={[
      { big: '20 years', text: 'fixing PCs, laptops and Macs on the Gold Coast' },
      { big: 'Microsoft', text: 'Certified Professional' },
      { big: 'Ex-IBM', text: 'previously IBM Australia’s youngest employee' },
      { big: 'Channel 9', text: 'featured on the news' },
    ]}
  />

  <ServiceReviews
    title="What customers say about our computer repairs."
    intro="In Gold Coast customers’ own words."
    picks={[0, 1, 3]}
  />

  <section class="sec" aria-labelledby="svc-areas-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="svc-eyebrow">Where we work</p>
        <h2 id="svc-areas-title">Computer repairs across the Gold Coast.</h2>
        <p class="lede">From Coomera to Coolangatta and up to Tamborine Mountain. Not sure if we cover your suburb? <a class="link" href="tel:+61447266455">Give us a call</a>.</p>
      </div>
      <Areas showBrands />
    </div>
  </section>

  <section class="sec sec-alt" aria-label="Frequently asked questions">
    <div class="wrap">
      <Faq title="Before you call: computer repair questions, answered." intro="Straight answers to what Gold Coast customers ask us most, including a few things worth knowing before you touch a broken computer. Can’t see your question? Call and you’ll talk to a technician, not a call centre." items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Get your computer fixed today."
    text="Book an onsite visit, connect remotely or drop it off. You’ll get the cause and the price before any work starts."
    href="#quote"
    label="Get a free quote"
  />
</PageLayout>
