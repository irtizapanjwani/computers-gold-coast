---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/redesign/Icon.astro';
import Areas from '../components/redesign/Areas.astro';
import Faq from '../components/redesign/Faq.astro';
import CtaBand from '../components/redesign/CtaBand.astro';
import ReviewBreakdown from '../components/redesign/ReviewBreakdown.astro';
import ReviewWall from '../components/redesign/ReviewWall.astro';
import ChoosingTips from '../components/redesign/ChoosingTips.astro';
import { businessSchema, breadcrumbSchema, faqSchema, SITE } from '../data/site';

const url = `${SITE}/reviews`;
const title = 'Customer Reviews | Computer Repairs Gold Coast';

const faqs = [
  { q: 'Are these reviews from real customers?', a: 'Yes. Every review on this page comes from a real Computers Gold Coast customer, shared in their own words.' },
  { q: 'How can I leave a review?', a: 'Send us your feedback through our <a href="/contact">contact page</a>. Let us know what the job was, your suburb and how it went.' },
  { q: 'Do you charge a call-out fee?', a: "No. There’s no call-out fee anywhere on the Gold Coast. You’ll know the price before any work starts." },
  { q: 'Which areas of the Gold Coast do you cover?', a: 'The whole Gold Coast, from Coomera and Helensvale in the north to Coolangatta in the south, and out to Nerang, Mudgeeraba and the hinterland. Remote support is available anywhere.' },
];

const schema = [
  { '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, about: { '@id': `${SITE}/#business` }, breadcrumb: { '@id': `${url}#breadcrumb` } },
    businessSchema,
    breadcrumbSchema(url, 'Reviews'),
  ] },
  faqSchema(faqs, url),
];
---
<PageLayout
  title={title}
  description="Real reviews of Computers Gold Coast: honest, affordable computer and laptop repairs, onsite or remote, no call-out fee. Plus tips on choosing a technician."
  shareDescription="What Gold Coast customers say about our computer and laptop repairs. Onsite or remote, no call-out fee."
  path="/reviews"
  schema={schema}
>
  <div class="hero-shell">
    <section class="hero-card about-hero" aria-labelledby="reviews-title">
      <div class="wrap about-hero-grid">
        <div>
          <div class="crumbs crumbs-dark" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Reviews</span></div>
          <p class="hero-eyebrow"><span aria-hidden="true"></span>Customer reviews</p>
          <h1 id="reviews-title">Computer repair reviews from <span class="hl">Gold Coast customers.</span></h1>
          <p class="hero-sub">Every review on this page is from a real Computers Gold Coast customer, in their own words. The list is short and grows one finished job at a time.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#reviews">Read the reviews <Icon name="arrow" /></a>
            <a class="btn btn-ghost-light" href="tel:+61447266455"><Icon name="phone" />0447 266 455</a>
          </div>
        </div>
        <ReviewBreakdown />
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 52C220 84 470 92 760 66C1040 41 1250 28 1440 46V90H0Z" />
      </svg>
    </section>
  </div>

  <section class="sec sec-alt" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        <h2>Computer repairs, in our customers’ words</h2>
        <p class="lede">Every computer and every fault is different, so these reviews show what working with us is like rather than promising the same result for every job.</p>
      </div>
      <ReviewWall />
    </div>
  </section>

  <ChoosingTips />

  <section class="sec">
    <div class="wrap leave">
      <div>
        <h2>Had a repair with us? We’d love to hear how it went.</h2>
        <p class="lede">Reviews from real customers help other Gold Coast locals choose a technician they can trust. Good or bad, we want to know, because it’s how we get better.</p>
        <div class="hero-actions"><a class="btn btn-dark" href="/contact">Share your feedback <Icon name="arrow" /></a></div>
      </div>
      <ol class="leave-steps">
        <li>Tell us honestly what went well and what didn’t.</li>
        <li>Mention the job and your suburb. It helps people with the same problem.</li>
        <li>Send it through our contact page and we’ll take it from there.</li>
      </ol>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head">
        <h2>Computer repairs for customers across the Gold Coast</h2>
        <p class="lede">We come to homes and offices all over the Gold Coast with no call-out fee. Read more <a class="link" href="/about">about Computers Gold Coast</a></p>
      </div>
      <Areas />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <Faq title="Questions about our reviews and service" intro="Want to talk to someone before you book? Call us any day between 7am and 10pm." items={faqs} />
    </div>
  </section>

  <CtaBand title="Need help with a similar problem?" text="Tell us the make, model, your suburb and what’s going wrong, and we’ll come back to you with a straight answer." />
</PageLayout>
