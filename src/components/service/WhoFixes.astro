---
// "Who fixes your computer": one big card. A single huge word on the left with the short story
// and credentials; on the right, what you get here versus what you won't. No icons and no boxes:
// type, rules and colour only. Top and bottom edges are drawn as a ribbon cable (grey wires
// with a blue "pin 1" wire), a nod to the inside of a PC.
// TODO(client): confirm the credentials.

interface Item { title: string; text: string }
interface Props {
  word: string;
  lead: string;
  credentials: string[];
  getTitle: string;
  get: Item[];
  notTitle: string;
  not: Item[];
  /** Optional closing line of HTML under the card (links allowed). */
  footer?: string;
}
const { word, lead, credentials, getTitle, get, notTitle, not, footer } = Astro.props;
---
<section class="sec who" aria-labelledby="svc-who-title">
  <div class="wrap">
    <div class="who-card">
      <span class="who-plug who-plug-a" aria-hidden="true"></span>
      <span class="who-plug who-plug-b" aria-hidden="true"></span>
      <div class="who-left">
        <h2 id="svc-who-title" class="who-word" style={`--chars:${word.length}`}>{word}</h2>
        <p class="who-lead">{lead}</p>
        <ul class="who-creds">{credentials.map((c) => <li>{c}</li>)}</ul>
        <p class="who-call">Talk to the technician: <a href="tel:+61447266455">0447 266 455</a></p>
      </div>

      <div class="who-col who-col-get">
        <h3>{getTitle}</h3>
        <ol>
          {get.map((it, i) => (
            <li>
              <span class="who-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div><strong>{it.title}</strong><span>{it.text}</span></div>
            </li>
          ))}
        </ol>
      </div>

      <div class="who-col who-col-not">
        <h3>{notTitle}</h3>
        <ul>
          {not.map((it) => (
            <li>
              <span class="who-n" aria-hidden="true">No</span>
              <div><strong>{it.title}</strong><span>{it.text}</span></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {footer && <p class="who-foot prose" set:html={footer} />}
  </div>
</section>
