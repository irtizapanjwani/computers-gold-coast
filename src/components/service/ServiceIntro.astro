---
// Service page intro: the story on the left, "what you get on every job" on the right.
import Icon from '../redesign/Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Paragraphs of HTML (links allowed). */
  paragraphs: string[];
  listTitle: string;
  list: { title: string; text: string }[];
}
const { eyebrow, title, paragraphs, listTitle, list } = Astro.props;
---
<section class="sec svc-intro" aria-labelledby="svc-intro-title">
  <div class="wrap svc-intro-grid">
    <div class="svc-intro-copy">
      <p class="svc-eyebrow">{eyebrow}</p>
      <h2 id="svc-intro-title">{title}</h2>
      <div class="prose">
        {paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
    <aside class="svc-intro-card" aria-labelledby="svc-intro-list">
      <h3 id="svc-intro-list">{listTitle}</h3>
      <ol class="svc-steps">
        {list.map((item, i) => (
          <li>
            <span class="svc-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </div>
          </li>
        ))}
      </ol>
      <a class="link" href="#quote">Get a free quote <Icon name="arrow" /></a>
    </aside>
  </div>
</section>
