---
// One large review plus two smaller ones, used on Home and About.
import Icon from './Icon.astro';
import { reviews } from '../../data/site';
const [lead, ...rest] = reviews.slice(0, 3);
---
<div class="rev-feature">
  <figure class="rev-big" style="margin:0">
    <div>
      <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
      <blockquote style="margin-top:20px">“{lead.quote}”</blockquote>
    </div>
    <figcaption class="rev-meta"><span class="rev-src">Google Review</span><a class="link" href="/reviews">Read all reviews <Icon name="arrow" /></a></figcaption>
  </figure>
  <div class="rev-side">
    {rest.map((r) => (
      <figure class="rev-card" style="margin:0">
        <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote>“{r.quote}”</blockquote>
        <figcaption class="rev-meta"><span class="rev-src">Google Review</span><a class="rev-tag" href={r.href}>{r.tag}</a></figcaption>
      </figure>
    ))}
  </div>
</div>
