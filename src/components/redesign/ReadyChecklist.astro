---
// About page: interactive "before you call" checklist (real checkboxes, progress ring) beside a
// compact "Good to know" card. Works without JS (native checkboxes); JS only updates the ring.
const items = [
  'The make and model (usually on a sticker underneath)',
  'When the problem started, and anything that changed just before',
  'Any error messages, beeps or warning lights',
  'Whether your files are backed up',
  'The charger, if it’s a laptop',
];
const R = 22;
const C = 2 * Math.PI * R;
---
<div class="prep" data-prep>
  <fieldset class="prep-list">
    <div class="prep-head">
      <div>
        <legend class="prep-title">Handy to have ready when you call</legend>
        <p class="prep-sub">Tick off what you’ve got. It helps us give you a straight answer faster.</p>
      </div>
      <div class="prep-ring" aria-hidden="true">
        <svg viewBox="0 0 56 56">
          <circle cx="28" cy="28" r={R} class="prep-ring-track" />
          <circle cx="28" cy="28" r={R} class="prep-ring-fill" style={`stroke-dasharray:${C}; stroke-dashoffset:${C}`} />
        </svg>
        <span><b class="prep-done">0</b>/{items.length}</span>
      </div>
    </div>
    <ul>
      {items.map((text, i) => (
        <li>
          <label>
            <input type="checkbox" name="prep" value={i} />
            <span class="prep-box" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg></span>
            <span class="prep-text">{text}</span>
          </label>
        </li>
      ))}
    </ul>
    <p class="prep-ready" role="status"><span>You’re all set.</span> <a href="tel:+61447266455">Call 0447 266 455 →</a></p>
  </fieldset>

  <aside class="prep-notes" aria-labelledby="prep-notes-title">
    <p class="prep-notes-eyebrow" id="prep-notes-title">Good to know</p>
    <div class="prep-note">
      <p class="prep-note-label">Every fault is different</p>
      <p>Repair options depend on the model and the fault. Data recovery can’t always be promised until we’ve looked at the drive.</p>
    </div>
    <div class="prep-note">
      <p class="prep-note-label">Not worth fixing?</p>
      <p>If a device isn’t economical to repair, we’ll tell you, and we can supply a report for your <a href="/insurance-reports-gold-coast">insurance claim</a>.</p>
    </div>
    <p class="prep-notes-foot">Not sure? Call <a href="tel:+61447266455">0447 266 455</a> and talk it through.</p>
  </aside>
</div>

<script>
  const prep = document.querySelector<HTMLElement>('[data-prep]');
  if (prep) {
    const boxes = [...prep.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const fill = prep.querySelector<SVGCircleElement>('.prep-ring-fill');
    const done = prep.querySelector<HTMLElement>('.prep-done');
    const length = fill ? parseFloat(fill.style.strokeDasharray) : 0;
    const update = () => {
      const n = boxes.filter((b) => b.checked).length;
      if (done) done.textContent = String(n);
      if (fill) fill.style.strokeDashoffset = String(length * (1 - n / boxes.length));
      prep.classList.toggle('is-complete', n === boxes.length);
    };
    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  }
</script>
